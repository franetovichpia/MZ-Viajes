rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ Cambiá estos correos por los de quienes administran el sitio (dueña y soporte).
    // Tienen que ser los mismos con los que se crean los usuarios en Authentication.
    function isOwner() {
      return request.auth != null
        && request.auth.token.email in ['DUENA@CORREO.COM', 'SOPORTE@CORREO.COM'];
    }

    // Todo el mundo puede LEER el catálogo; solo el dueño puede ESCRIBIR
    match /packages/{id} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /photos/{id} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /site/{doc} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
