rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ Cambiá este correo por el del dueño de Terromadas (el mismo con el que crea su usuario)
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'DUENO@CORREO.COM';
    }

    // Todo el mundo puede LEER el catálogo; solo el dueño puede ESCRIBIR
    match /packages/{id} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /photos/{id} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /site/{doc} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
